// ASTC 4x4 NORMAL (X,Y -> luminance + alpha) encoder: one thread per 4x4
// block, block min/max + refinement (no network). GLSL port of
// anbc_astc_scalar.metal.
#version 450
#extension GL_GOOGLE_include_directive : enable

#include "anbc_astc_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main()
{
    const uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= P.blocksX || gid.y >= P.blocksY)
        return;
    vec4 px[16];
    loadBlock(gid, px);
    vec2 e0 = px[0].rg, e1 = px[0].rg;
    for (uint i = 1u; i < 16u; i++) { e0 = min(e0, px[i].rg); e1 = max(e1, px[i].rg); }
    uOut.blocks[P.blockBase + gid.y * P.blocksX + gid.x] = encodeAstcNormal(px, e0, e1, P.refineIters);
}
